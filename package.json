{
  "name": "game-atlas-discord-bot",
  "version": "1.0.0",
  "description": "Cross-Platform Free Game Discovery Bot for Discord",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "deploy-commands": "ts-node src/discord/deployCommands.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
